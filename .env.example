# Sao chép thành .env và điền giá trị. KHÔNG commit .env.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL 14+ (Neon: dán chuỗi kết nối, SSL tự bật với host neon.tech)
DATABASE_URL=postgres://hht:doi-mat-khau@localhost:5432/hht_tuyen_sinh
DATABASE_SSL=false
# true = dùng PostgreSQL chạy bằng Docker (hht-tuyen-sinh.bat tự khởi động)
USE_DOCKER_DB=false
DB_POOL_MAX=10
POSTGRES_PASSWORD=doi-mat-khau

# Chuỗi kết nối Neon dùng cho dong-bo-neon-docker.bat (để trống: hỏi khi chạy lần đầu)
NEON_DATABASE_URL=

# Định danh bản chạy (để trống: tự sinh) – dùng cho bus realtime giữa nhiều bản chạy
INSTANCE_ID=
TRUST_PROXY=1
SCHEDULER_ENABLED=true
JOB_RUNNER_ENABLED=true
UPLOAD_DIR=data/uploads

# Bảo mật
VISITOR_HASH_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# Khóa mã hóa khóa API AI lưu trong CSDL. Để trống = dùng VISITOR_HASH_SECRET.
# Đổi giá trị này (hoặc VISITOR_HASH_SECRET khi để trống) thì phải nhập lại khóa API trên trang Cài đặt AI.
SECRET_ENCRYPTION_KEY=
ALLOWED_ORIGINS=
CSP_CONNECT_SRC=
CSP_IMG_SRC=
CSP_FRAME_SRC=

# Gemini: nhiều key phân tách dấu phẩy -> xoay vòng, cooldown theo loại lỗi.
# Có thể để trống và thêm khóa trên trang Quản trị > Cài đặt AI (không cần khởi động lại).
# Không có khóa nào: trợ lý vẫn chạy bằng FAQ + trích dẫn văn bản (không gọi LLM).
GEMINI_API_KEYS=

# Quản trị viên đầu tiên (chỉ dùng khi chưa có SUPER_ADMIN; bắt đổi mật khẩu lần đầu)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# Fanpage Messenger (bật MESSENGER_ENABLED trong trang Admin)
MESSENGER_VERIFY_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_PAGE_TOKEN=

# docker-compose: tên miền cho Caddy (HTTPS tự động) và số bản sao lưu giữ lại
DOMAIN=localhost
BACKUP_KEEP=14
